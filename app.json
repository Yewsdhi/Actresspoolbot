{
  "name": "actress-arena-gold",
  "description": "Premium Telegram Actress Guess and Auction Game Bot",
  "repository": "https://github.com/Yewsdhi/Actresspoolbot",
  "keywords": [
    "telegram",
    "actress-game",
    "auction",
    "guessing",
    "poll"
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "ADMIN_IDS": {
      "description": "Comma-separated numeric Telegram admin IDs",
      "required": true
    },
    "DB_PATH": {
      "description": "SQLite database path (ephemeral on Heroku)",
      "value": "/tmp/actress_arena.db"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
