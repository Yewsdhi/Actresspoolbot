{
  "name": "bollywood-auction-poll-bot",
  "description": "Telegram group game with team registration, live auction bidding and a five-category photo poll finale.",
  "repository": "https://github.com/Yewsdhi/Actresspoolbot",
  "keywords": [
    "telegram",
    "auction",
    "poll",
    "python",
    "game"
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "ADMIN_IDS": {
      "description": "Comma-separated Telegram numeric admin IDs",
      "required": true
    },
    "STARTING_COINS": {
      "description": "Starting coins per team",
      "value": "300"
    },
    "DB_PATH": {
      "description": "SQLite database file path",
      "value": "data/auction.db"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
